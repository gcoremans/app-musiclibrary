{
  "version": "0.1",
  "prefixes": {
    "schema": "http://schema.org/",
    "foaf": "http://xmlns.com/foaf/0.1/"
  },
  "resources": {
    "releases": {
      "name": "release",
      "class": "schema:MusicRelease",
      "attributes": {
        "title": {
          "type": "string",
          "predicate": "schema:name"
        },
        "credit": {
          "type": "string",
          "predicate": "schema:creditedTo"
        },
        "format": {
          "type": "string",
          "predicate": "schema:musicReleaseFormat"
        }
      },
      "relationships": {
        "tracks": {
          "predicate": "schema:track",
          "target": "recording",
          "cardinality": "many"
        },
        "group": {
          "predicate": "schema:albumRelease",
          "target": "release-group",
          "cardinality": "one",
          "inverse": true
        }
      },
      "features": ["include-uri"],
      "new-resource-base": "http://musicbrainz.org/release/"
    },

    "recordings": {
      "name": "recording",
      "class": "schema:MusicRecording",
      "attributes": {
        "title": {
          "type": "string",
          "predicate": "schema:name"
        },
        "credit": {
          "type": "string",
          "predicate": "schema:creditedTo"
        },
        "duration": {
          "type": "string",
          "predicate": "schema:duration"
        }
      },
      "relationships": {
        "on": {
          "predicate": "schema:track",
          "target": "release",
          "cardinality": "many",
          "inverse": true
        },
        "by": {
          "predicate": "schema:byArtist",
          "target": "artist",
          "cardinality": "many"
        }
      },
      "features": ["include-uri"],
      "new-resource-base": "http://musicbrainz.org/recording/"
    },

    "artists": {
      "name": "artist",
      "class": "schema:MusicGroup",
      "attributes": {
        "name": {
          "predicate": "schema:name",
          "type": "string"
        }
      },
      "relationships": {
        "albums": {
          "predicate": "schema:album",
          "target": "release-group",
          "cardinality": "many"
        },
        "tracks": {
          "predicate": "schema:byArtist",
          "target": "recording",
          "cardinality": "many",
          "inverse": true
        }
      },
      "features": ["include-uri"],
      "new-resource-base": "http://musicbrainz.org/artist/"
    },

    "release-groups": {
      "name": "release-group",
      "class": "schema:MusicAlbum",
      "attributes": {
        "title": {
          "predicate": "schema:name",
          "type": "string"
        },
        "credit": {
          "predicate": "schema:creditedTo",
          "type": "string"
        }
      },
      "relationships": {
        "artists": {
          "predicate": "schema:album",
          "target": "artist",
          "cardinality": "many",
          "inverse": true
        },
        "releases": {
          "predicate": "schema:albumRelease",
          "target": "release",
          "cardinality": "many"
        }
      },
      "features": ["include-uri"],
      "new-resource-base": "http://musicbrainz.org/release-group/"
    },



    "persons": {
      "name": "person",
      "class": "foaf:Person",
      "attributes": {
        "name": {
          "predicate": "foaf:name",
          "type": "string"
        }
      },
      "relationships": {
        "account": {
          "predicate": "foaf:account",
          "target": "account",
          "cardinality": "one"
        }
      },
      "features": ["include-uri"],
      "new-resource-base": "http://mu.semte.ch/vocabularies/people/"
    },

    "accounts": {
      "name": "account",
      "class": "foaf:OnlineAccount",
      "attributes": {
        "name": {
          "predicate": "foaf:accountName",
          "type": "string"
        }
      },
      "relationships": {
        "person": {
          "predicate": "foaf:account",
          "target": "person",
          "cardinality": "one",
          "inverse": true
        },
        "collections": {
          "predicate": "schema:owner",
          "target": "collection",
          "cardinality": "many",
          "inverse": true
        }
      },
      "features": ["include-uri"],
      "new-resource-base": "http://mu.semte.ch/vocabularies/accounts/"
    },

    "collections": {
      "name": "collection",
      "class": "schema:Collection",
      "attributes": {
        "name": {
          "predicate": "schema:name",
          "type": "string"
        }
      },
      "relationships": {
        "owner": {
          "predicate": "schema:owner",
          "target": "account",
          "cardinality": "one"
        },
        "parts": {
          "predicate": "schema:hasPart",
          "target": "release",
          "cardinality": "many"
        }
      },
      "features": ["include-uri"],
      "new-resource-base": "http://mu.semte.ch/vocabularies/collections/"
    }
  }
}
